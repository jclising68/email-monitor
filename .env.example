# ── Required ──────────────────────────────────────────────────────────────────

# Slack incoming webhook URL
# Create one at: https://api.slack.com/apps → your app → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXXX/BXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX

# Google Sheets document ID (the long string in the URL between /d/ and /edit)
GOOGLE_SHEETS_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789

# Google Service Account credentials — pick ONE of the two options below:

# Option A (recommended for Railway/Render): base64-encode your service-account JSON
#   macOS/Linux: base64 -i service_account.json | tr -d '\n'
GOOGLE_CREDENTIALS_JSON_B64=

# Option B (local dev): path to the service-account JSON file on disk
# GOOGLE_CREDENTIALS_JSON_FILE=/path/to/service_account.json

# ── Optional ──────────────────────────────────────────────────────────────────

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Override Instantly API base URL (useful for integration tests against a mock)
# INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2

# Maximum number of auto-reconnect attempts before giving up (Mission Inbox AND ZapMail)
MAX_RECONNECT_ATTEMPTS=5

# Hours between re-alerting on a ZapMail disconnect (0 = alert once and never repeat)
ZAPMAIL_REALERT_HOURS=0

# ── ZapMail (optional — enables auto-reconnect for ZapMail/OAuth accounts) ───
# Only ZAPMAIL_API_KEY goes here. Workspace IDs go in the 'workspaces' Google Sheet
# column 'zapmail_workspace_key' — one ID per row for workspaces that have ZapMail accounts.

# Your ZapMail API key  →  app.zapmail.ai → Settings → primary workspace → API Keys
ZAPMAIL_API_KEY=

# Override ZapMail API base URL (leave blank to use default)
# ZAPMAIL_API_BASE_URL=https://api.zapmail.ai/api
