# ─────────────────────────────────────────────────────────────────────────────
# Almost all configuration now lives in the Google Sheet, not here.
#
#   • Per-client API keys        → the "Workspaces" tab (one row per client)
#   • Slack webhook + global keys → the "Settings" tab (key | value | notes),
#                                   created and seeded automatically on first run
#   • Tuning thresholds          → code defaults in config.py
#
# This file only needs the TWO values that bootstrap reading the Sheet itself.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Google Sheets document ID (the long string in the URL between /d/ and /edit)
GOOGLE_SHEETS_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789

# Google OAuth2 user token, base64-encoded (for CI / servers — no browser).
# Generate locally first: run `python monitor.py` once, approve the browser
# consent (writes token.json), then:
#   macOS/Linux:  base64 -i token.json | tr -d '\n'
GOOGLE_TOKEN_JSON_B64=

# Local dev only: if GOOGLE_TOKEN_JSON_B64 is unset, the code uses
# credentials.json + token.json in the project root and opens a browser on
# first run. Nothing to set here for that path.

# ── Optional fallbacks (normally set in the Sheet's "Settings" tab) ──────────
# A non-empty Sheet value always wins over these. Keep SLACK_WEBHOOK_URL set as
# a fallback so crash alerts still fire if the Sheet is ever unreadable.

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXXX/BXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX
# ZAPMAIL_API_KEY=
# PREMIUMINBOX_API_TOKEN=
# SCALEDMAIL_API_KEY=

# ── Optional (rarely changed) ───────────────────────────────────────────────

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Override provider API base URLs (for tests / mocks) — leave unset in production
# INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2
# ZAPMAIL_API_BASE_URL=https://api.zapmail.ai/api
# PREMIUMINBOX_API_BASE_URL=https://portal.premiuminboxes.com/api/client
# SCALEDMAIL_API_BASE_URL=https://api.scaledmail.com/api/v1
